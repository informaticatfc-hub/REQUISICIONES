# ============================================================
# The Fuentes Workspace - .htaccess (Fase 2)
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ------------------------------------------------------------
# Cabeceras de seguridad
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HSTS solo si HTTPS esta activo. Comentado por defecto.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CSP minimo. Ajustar segun los CDN que se usen.
    Header always set Content-Security-Policy "default-src 'self'; \
        script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.datatables.net https://code.jquery.com https://unpkg.com; \
        style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.datatables.net https://fonts.googleapis.com; \
        font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; \
        img-src 'self' data:; \
        connect-src 'self'; \
        frame-ancestors 'self'"
</IfModule>

# ------------------------------------------------------------
# Bloqueo de archivos sensibles
# ------------------------------------------------------------
<FilesMatch "\.(sql|md|log|env|gitignore|gitattributes|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Bloqueo del directorio de migraciones
RedirectMatch 403 ^/api/migrations/.*$

# ------------------------------------------------------------
# Compresion
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------
# Cache de assets estaticos
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 90 days"
</IfModule>
